# Copy to .env and adjust. Every variable is optional - defaults suit local development.
BOOKWORM_MONGODB_URL=mongodb://localhost:27017
BOOKWORM_MONGODB_DB=bookworm
# Use a long random value in any shared / production environment
BOOKWORM_JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
BOOKWORM_JWT_EXPIRE_MINUTES=10080
# JSON array
BOOKWORM_CORS_ORIGINS=["http://localhost:4200","http://localhost:4300"]
# Load books / writers / coupons / demo account into an empty database on startup
BOOKWORM_SEED_ON_STARTUP=true
